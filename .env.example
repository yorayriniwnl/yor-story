# Reflections — environment variables
# Copy to .env.local and fill in values.

# Resend email API (https://resend.com)
# If either is unset, /api/subscribe logs and returns a dev-mode success response
# instead of failing — so you can develop locally without real keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Public site URL (used in generateMetadata for canonical + OG image URLs)
NEXT_PUBLIC_SITE_URL=https://yorayriniwnl.vercel.app
